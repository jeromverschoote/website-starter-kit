BRANCH=$(git symbolic-ref HEAD | sed 's|refs/heads/||')

if [ "$BRANCH" = "main" ]; then
  echo "Direct pushes to 'main' are not allowed. Push to 'development' and open a pull request."
  exit 1
fi

# The one "definition of done" gate: lint -> check-types -> unit tests (cached,
# affected-only via turbo). Heavier gates (build, e2e, bundle-size) run in CI.
echo "Running verify (lint, check-types, test)..."
yarn verify
