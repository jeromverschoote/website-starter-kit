BRANCH=$(git symbolic-ref HEAD | sed 's|refs/heads/||')

if [ "$BRANCH" = "main" ]; then
  echo "Direct pushes to 'main' are not allowed. Push to 'development' and open a pull request."
  exit 1
fi

# Fast, local pre-push gate: lint -> types -> unit tests.
# Heavier gates (build, e2e, bundle-size) run in CI on the pull request.

echo "Running lint..."
yarn lint

echo "Running type checks..."
yarn workspace @repo/web run check-types
yarn workspace @repo/ui run check-types

echo "Running unit & component tests..."
yarn test
