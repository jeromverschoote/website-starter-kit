{
  "name": "website-starter-kit",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "verify": "turbo lint check-types test",
    "verify:affected": "turbo lint check-types test --affected",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "web:dev": "yarn workspace web run dev",
    "web:build": "yarn workspace web run build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "init:project": "tsx scripts/init-project.ts",
    "prepare": "husky && node scripts/init-banner.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "react": "19.2.2",
    "react-dom": "19.2.2",
    "styled-components": "^6.4.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "config/*",
    "packages/*"
  ],
  "nohoist": [
    "**/react",
    "**/react/**",
    "**/react-dom",
    "**/react-dom/**",
    "**/@sanity/**"
  ]
}
