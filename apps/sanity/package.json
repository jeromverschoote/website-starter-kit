{
  "name": "@repo/sanity",
  "version": "1.0.0",
  "private": true,
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "types:generate": "sanity schema extract --enforce-required-fields --path ../web/src/types/sanity-schemas.json && sanity typegen generate",
