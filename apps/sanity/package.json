{
  "name": "@repo/sanity",
  "version": "1.0.0",
  "private": true,
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "types:generate": "sanity schema extract --enforce-required-fields --path ../web/src/types/sanity-schemas.json && sanity typegen generate",
    "import-dataset": "sanity dataset import datasets/20250821-production-collection-dump.ndjson production --replace --allow-failing-assets"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@repo/ui": "*",
    "@sanity/document-internationalization": "^3.3.3",
    "@sanity/icons": "^3.7.4",
    "@sanity/vision": "^5.31.1",
    "eslint-config-prettier": "^10.1.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanity": "^5.31.1",
    "sanity-plugin-media": "^3.0.5",
    "sanity-plugin-vercel-deploy": "^3.3.4",
    "sanity-plugin-webhooks-trigger": "^0.9.0",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@turbo/gen": "^2.9.18",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  }
