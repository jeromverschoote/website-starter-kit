    "sanity-plugin-webhooks-trigger": "^0.9.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^5.0.2",
    "@turbo/gen": "^2.10.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
