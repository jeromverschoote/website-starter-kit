# ─── Font Awesome Pro ─────────────────────────────────────────────────────────
# Required to install @fortawesome packages from the private registry.
# Get your token at: https://fontawesome.com/account
FONTAWESOME_NPM_AUTH_TOKEN=

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Found in your Sanity project dashboard: https://sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET_ID=production
# Secret used to validate on-demand ISR revalidation webhooks from Sanity.
SANITY_REVALIDATE_SECRET=

# ─── Site ─────────────────────────────────────────────────────────────────────
# Full base URL used for sitemap and robots.txt generation (no trailing slash).
NEXT_SITEMAP_BASE_DOMAIN_URL=https://www.example.com
# Author metadata used in page <head> tags.
AUTHOR_NAME=
AUTHOR_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
# PostHog (https://posthog.com) — product analytics & session recording.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Optional.
GOOGLE_TAG_MANAGER_ID=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional.
GOOGLE_ANALYTICS_ID=
# Google Maps Embed API key — only needed if embedding maps. Optional.
GOOGLE_MAPS_EMBED_API_KEY=

# ─── Contact form ─────────────────────────────────────────────────────────────
# Notion integration for storing contact form submissions.
NOTION_API_TOKEN=
NOTION_CONTACT_REQUESTS_DATABASE_ID=
# Slack incoming webhook URL for new submission notifications. Optional.
SLACK_WEBHOOK_URL=

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Upstash Redis (https://upstash.com) — used for contact form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── API security ─────────────────────────────────────────────────────────────
# Bearer token for protecting internal API routes.
NEXT_WEBHOOK_API_TOKEN=
API_ACCESS_TOKEN=
